# ----------------------------------------------------------------------------
# Tuckshop – environment template.
#
#   cp .env.example .env.local      (local development; .env.local is git-ignored)
#
# This file contains PLACEHOLDERS ONLY. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser – never put secrets there.
# See docs/PRODUCTION_READINESS.md §3 for per-environment configuration.
# ----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (hosted dev project) -------------------------------------------
# Project Settings -> API. The publishable key is safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_. Never log. Never ship to the browser.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# SERVER ONLY. Postgres URI for migrations/tests (DEV project only). NEVER production.
# Prefer Supabase Connect → URI → **Session pooler** (port 6543). If you use the direct host
# (db.*.supabase.co:5432), `npm run db:check` auto-rewrites to the pooler for local networks.
# Use **Copy** after resetting the DB password — no [brackets]; encode @ in passwords as %40.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:REPLACE_ME@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# --- Safety switches (must be false/unset in production) ----------------------
# Shows the role-interface shells without authentication (Phase 1 only; fails closed otherwise).
UI_SHELL_PREVIEW=false
# Enables the development-only simulated NFC card reader. Refused when APP_ENV=production.
SIMULATED_NFC_ENABLED=false
# Password lock after 10 min idle on POS (cashier must re-enter password). Default off.
POS_INACTIVITY_LOCK_ENABLED=false

# --- Payments (PayFast) -------------------------------------------------------
# sandbox | live. Live is refused until the production-readiness gates are met.
PAYFAST_MODE=sandbox
# Platform-level SANDBOX credentials for development/tests. Per-school live credentials
# are stored encrypted in the database (docs/PAYMENTS_AND_LEDGER.md §2).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# --- Email --------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM=

# --- Security secrets (required when APP_ENV=production) ----------------------
# >= 32 random chars. Signs the httpOnly active-context preference cookie.
AUTH_CONTEXT_SECRET=

# >= 32 random chars. Protects /api/cron/* endpoints.
CRON_SECRET=
# >= 32 random chars. HMAC pepper for NFC credential references.
CREDENTIAL_PEPPER=
# Base64, 32 bytes. Key-encryption key for stored provider credentials.
ENCRYPTION_KEK=
# Base64, 16 bytes. NFC master key (version 1) for per-card key diversification.
NFC_MASTER_KEY_V1=

# --- Observability / rate limiting (optional until Phase 2 / 12) -------------
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Tooling ------------------------------------------------------------------
# Set to 1 ONLY in CI builds / unit tests that do not need real configuration.
# SKIP_ENV_VALIDATION=1
